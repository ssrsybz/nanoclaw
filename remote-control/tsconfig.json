{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@protocols/*": ["shared/protocols/*"],
      "@auth/*": ["shared/auth/*"]
    }
  },
  "references": [
    { "path": "./shared" },
    { "path": "./terminal-service" },
    { "path": "./cloud-relay" }
  ],
  "include": ["shared/**/*", "terminal-service/**/*", "cloud-relay/**/*"],
  "exclude": ["node_modules", "dist", "mobile-client"]
}
